rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (
          request.auth.token.email_verified == true &&
          request.auth.token.email in ['m.a.ali19140@gmail.com', 'alyafei6866@gmail.com']
        ) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSafeUrl(url, maxLen) {
      return url is string &&
        url.size() >= 5 &&
        url.size() <= maxLen &&
        (url.matches('^https://.*') || url.matches('^http://.*') || url.matches('^/.*'));
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll([
          'pharmacyName', 'tagline', 'email', 'phoneDisplay', 'whatsappIntl',
          'address', 'coords', 'mapsUrl', 'hoursLabel', 'commercialReg',
          'licenseNumber', 'vatNumber', 'heroEyebrow', 'heroTitle',
          'heroSubtitle', 'heroImageSrc', 'storeTitle', 'storeSubtitle',
          'freeDeliveryThreshold', 'deliveryFee', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'pharmacyName', 'tagline', 'email', 'phoneDisplay', 'whatsappIntl',
          'address', 'coords', 'mapsUrl', 'hoursLabel', 'commercialReg',
          'licenseNumber', 'vatNumber', 'heroEyebrow', 'heroTitle',
          'heroSubtitle', 'heroImageSrc', 'storeTitle', 'storeSubtitle',
          'freeDeliveryThreshold', 'deliveryFee', 'createdAt', 'updatedAt'
        ]) &&
        data.pharmacyName is string && data.pharmacyName.size() >= 2 && data.pharmacyName.size() <= 120 &&
        data.tagline is string && data.tagline.size() >= 2 && data.tagline.size() <= 200 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 120 &&
        data.phoneDisplay is string && data.phoneDisplay.size() >= 8 && data.phoneDisplay.size() <= 30 &&
        data.whatsappIntl is string && data.whatsappIntl.size() >= 8 && data.whatsappIntl.size() <= 30 &&
        data.address is string && data.address.size() >= 4 && data.address.size() <= 200 &&
        data.coords is string && data.coords.size() >= 5 && data.coords.size() <= 80 &&
        isSafeUrl(data.mapsUrl, 400) &&
        data.hoursLabel is string && data.hoursLabel.size() >= 2 && data.hoursLabel.size() <= 80 &&
        data.commercialReg is string && data.commercialReg.size() >= 4 && data.commercialReg.size() <= 40 &&
        data.licenseNumber is string && data.licenseNumber.size() >= 4 && data.licenseNumber.size() <= 40 &&
        data.vatNumber is string && data.vatNumber.size() >= 4 && data.vatNumber.size() <= 40 &&
        data.heroEyebrow is string && data.heroEyebrow.size() >= 2 && data.heroEyebrow.size() <= 200 &&
        data.heroTitle is string && data.heroTitle.size() >= 4 && data.heroTitle.size() <= 200 &&
        data.heroSubtitle is string && data.heroSubtitle.size() >= 10 && data.heroSubtitle.size() <= 500 &&
        isSafeUrl(data.heroImageSrc, 600) &&
        data.storeTitle is string && data.storeTitle.size() >= 4 && data.storeTitle.size() <= 200 &&
        data.storeSubtitle is string && data.storeSubtitle.size() >= 10 && data.storeSubtitle.size() <= 500 &&
        data.freeDeliveryThreshold is number && data.freeDeliveryThreshold >= 0 && data.freeDeliveryThreshold <= 10000 &&
        data.deliveryFee is number && data.deliveryFee >= 0 && data.deliveryFee <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'name', 'category', 'size', 'price', 'imageSrc', 'imageAlt',
          'shortNote', 'description', 'pharmacistTip', 'stockNote',
          'sortOrder', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name', 'category', 'size', 'price', 'originalPrice', 'imageSrc',
          'imageAlt', 'shortNote', 'description', 'pharmacistTip', 'stockNote',
          'sortOrder', 'createdAt', 'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 160 &&
        data.category is string && data.category.size() >= 2 && data.category.size() <= 60 &&
        data.size is string && data.size.size() >= 1 && data.size.size() <= 120 &&
        data.price is number && data.price > 0 && data.price <= 100000 &&
        (!('originalPrice' in data) || (data.originalPrice is number && data.originalPrice >= data.price && data.originalPrice <= 100000)) &&
        isSafeUrl(data.imageSrc, 600) &&
        data.imageAlt is string && data.imageAlt.size() >= 2 && data.imageAlt.size() <= 200 &&
        data.shortNote is string && data.shortNote.size() >= 2 && data.shortNote.size() <= 240 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 1000 &&
        data.pharmacistTip is string && data.pharmacistTip.size() >= 5 && data.pharmacistTip.size() <= 600 &&
        data.stockNote is string && data.stockNote.size() >= 2 && data.stockNote.size() <= 120 &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFaqItem(data) {
      return data.keys().hasAll(['question', 'answer', 'sortOrder', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['question', 'answer', 'sortOrder', 'createdAt', 'updatedAt']) &&
        data.question is string && data.question.size() >= 4 && data.question.size() <= 300 &&
        data.answer is string && data.answer.size() >= 5 && data.answer.size() <= 1200 &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDepartment(data) {
      return data.keys().hasAll(['index', 'name', 'summary', 'guidance', 'items', 'sortOrder', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['index', 'name', 'summary', 'guidance', 'items', 'sortOrder', 'createdAt', 'updatedAt']) &&
        data.index is string && data.index.size() >= 1 && data.index.size() <= 10 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        data.summary is string && data.summary.size() >= 5 && data.summary.size() <= 400 &&
        data.guidance is string && data.guidance.size() >= 5 && data.guidance.size() <= 500 &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 10 &&
        data.items[0] is string && data.items[0].size() <= 120 &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGalleryPhoto(data) {
      return data.keys().hasAll([
          'title', 'category', 'subtitle', 'description', 'imageSrc',
          'imageAlt', 'aspectClass', 'featured', 'sortOrder', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'category', 'subtitle', 'description', 'imageSrc',
          'imageAlt', 'aspectClass', 'featured', 'sortOrder', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 200 &&
        data.category is string && data.category.size() >= 2 && data.category.size() <= 80 &&
        data.subtitle is string && data.subtitle.size() >= 2 && data.subtitle.size() <= 200 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 600 &&
        isSafeUrl(data.imageSrc, 600) &&
        data.imageAlt is string && data.imageAlt.size() >= 2 && data.imageAlt.size() <= 200 &&
        data.aspectClass is string && data.aspectClass.size() >= 4 && data.aspectClass.size() <= 40 &&
        data.featured is bool &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /siteSettings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'main';
      allow list: if false;
      allow create: if isSignedIn() &&
        isValidId(settingId) &&
        settingId == 'main' &&
        isValidSiteSettings(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isSignedIn() &&
        isValidId(settingId) &&
        settingId == 'main' &&
        isValidSiteSettings(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'pharmacyName', 'tagline', 'email', 'phoneDisplay', 'whatsappIntl',
          'address', 'coords', 'mapsUrl', 'hoursLabel', 'commercialReg',
          'licenseNumber', 'vatNumber', 'heroEyebrow', 'heroTitle',
          'heroSubtitle', 'heroImageSrc', 'storeTitle', 'storeSubtitle',
          'freeDeliveryThreshold', 'deliveryFee', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if false;
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if request.query.limit != null && request.query.limit <= 100;
      allow create: if isSignedIn() &&
        isValidId(productId) &&
        isValidProduct(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isSignedIn() &&
        isValidId(productId) &&
        isValidProduct(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'category', 'size', 'price', 'originalPrice', 'imageSrc',
          'imageAlt', 'shortNote', 'description', 'pharmacistTip', 'stockNote',
          'sortOrder', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isSignedIn() && isValidId(productId) && isAdmin();
    }

    match /faqs/{faqId} {
      allow get: if isValidId(faqId);
      allow list: if request.query.limit != null && request.query.limit <= 100;
      allow create: if isSignedIn() &&
        isValidId(faqId) &&
        isValidFaqItem(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isSignedIn() &&
        isValidId(faqId) &&
        isValidFaqItem(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'question', 'answer', 'sortOrder', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isSignedIn() && isValidId(faqId) && isAdmin();
    }

    match /departments/{deptId} {
      allow get: if isValidId(deptId);
      allow list: if request.query.limit != null && request.query.limit <= 100;
      allow create: if isSignedIn() &&
        isValidId(deptId) &&
        isValidDepartment(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isSignedIn() &&
        isValidId(deptId) &&
        isValidDepartment(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'index', 'name', 'summary', 'guidance', 'items', 'sortOrder', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isSignedIn() && isValidId(deptId) && isAdmin();
    }

    match /gallery/{photoId} {
      allow get: if isValidId(photoId);
      allow list: if request.query.limit != null && request.query.limit <= 100;
      allow create: if isSignedIn() &&
        isValidId(photoId) &&
        isValidGalleryPhoto(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isSignedIn() &&
        isValidId(photoId) &&
        isValidGalleryPhoto(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'category', 'subtitle', 'description', 'imageSrc',
          'imageAlt', 'aspectClass', 'featured', 'sortOrder', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isSignedIn() && isValidId(photoId) && isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection';
      allow list, create, update, delete: if false;
    }
  }
}
